# Supabase : DATABASE_URL = connexion poolée (port 6543, ?pgbouncer=true), DIRECT_URL = connexion directe (port 5432)
DATABASE_URL="postgresql://alerteagri:alerteagri@localhost:5437/alerteagri?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000



DIRECT_URL="postgresql://alerteagri:alerteagri@localhost:5437/alerteagri?schema=public"
SEED_STAFF_PIN=
RECEIPT_SECRET=
USSD_SECRET=
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173
WEATHER_AUTO_REFRESH=false

# Limits (per minute). Defaults shown; production raises the general one for rooms sharing a network.
RATE_LIMIT_PER_MIN=120
LOGIN_LIMIT_PER_MIN=5
LOGIN_IP_LIMIT_PER_MIN=30
VOICE_LIMIT_PER_MIN=4

# Fon and Yoruba voices (229langues). Without them, the platform works minus voice generation.
LANGUES229_API_KEY=
LANGUES229_BEARER=
