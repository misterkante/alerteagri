MOMO_TARGET_ENVIRONMENT=sandbox

# A brancher plus tard sur un vrai compte Africa's Talking pour l'USSD/SMS reel.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=

