# Supabase : DATABASE_URL = connexion poolée (port 6543, ?pgbouncer=true), DIRECT_URL = connexion directe (port 5432)
DATABASE_URL="postgresql://alerteagri:alerteagri@localhost:5437/alerteagri?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3000

# A brancher plus tard sur un vrai compte marchand MTN MoMo (sandbox puis production).
MOMO_PROVIDER=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
